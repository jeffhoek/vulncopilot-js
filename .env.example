# Copy to `.env.local` and fill in. NEVER commit real secrets.
# List values (ALLOWED_*, ACTION_BUTTONS, ADMIN_USER_IDENTIFIERS) are JSON arrays,
# NOT comma-separated — a bare `a@x.com,b@y.com` will fail zod validation on boot.

# ── API Keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key            # used for embeddings (text-embedding-3-small)

# ── PostgreSQL (shared with the Python ETL repo) ──────────────────────────
# This app is READ-MOSTLY: it does not create schema. The Python ETL side owns DDL.
# Point this at the same database the ETL pipeline populates.
# SECURITY: connect as a least-privileged, NON-superuser role — the `query` tool
# runs LLM-generated SQL, and that role's privileges are the real containment
# boundary. Use the `app_readonly` role (SELECT on the corpus + SELECT/INSERT/UPDATE
# on user_usage); see the reference repo's docs/supabase-readonly-role.md. The app
# logs a loud warning at boot if it connects as a superuser.
PG_DATABASE_URL=postgresql://app_readonly:apppw@localhost:5432/inventory
# Managed Postgres (e.g. Timescale/Supabase) — append sslmode=require
# PG_DATABASE_URL=postgresql://user:pw@host:5432/dbname?sslmode=require
# Timeouts (milliseconds) — tunable without a rebuild. PG_STATEMENT_TIMEOUT_MS
# caps each `query` tool statement (bounds a slow read like SELECT pg_sleep(...));
# PG_CONNECTION_TIMEOUT_MS is how long to wait for a free pooled connection.
# PG_STATEMENT_TIMEOUT_MS=15000
# PG_CONNECTION_TIMEOUT_MS=10000

# ── RAG (optional — sane defaults) ────────────────────────────────────────
# TOP_K=5
# MAX_HISTORY_MESSAGES=50
# Pinned — must match the vectors already stored by the ETL side. Do not change
# without re-embedding the whole corpus.
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=claude-sonnet-5
# Anthropic effort: low | medium | high | max. "low" suits short scoped lookups and
# avoids the ~4x latency of adaptive thinking. Leave blank for models without effort.
LLM_EFFORT=low
# SYSTEM_PROMPT overrides the built-in prompt. The built-in prompt embeds the full DB
# schema (tables, columns, JOIN guidance) the SQL tool depends on — if you override it,
# include that schema context or query quality degrades badly. See src/mastra/agents.
# SYSTEM_PROMPT=

# Quick-query button labels shown in the chat UI (JSON array).
# Note: "Biggest EPSS movers" returns nothing until a second daily EPSS publication has
# loaded (previous_probability is NULL before then) — expected on a fresh database, not a bug.
# The three risk-score buttons need the `v_cve_risk` materialized view, which the Python
# ETL side creates and refreshes; without it they fail with an undefined-relation error.
# ACTION_BUTTONS=["List the 10 newest KEV entries by date_added","List KEV entries with known ransomware use","CVE-2021-44228 (Log4Shell)","CVE-2017-0144 (EternalBlue)","CVE-2023-34362 (MOVEit Transfer)","Reference URLs for CVE-2025-53770 (SharePoint ToolShell)","Top 10 AI-related CVEs in 2026 by CVSS score","LLM prompt injection vulns","typo squatting","Anthropic Claude vulns","VPN and remote access vulns","Top vendors in KEV","Which weakness types appear most in KEV?","Top actively-exploited, automatable, total-impact CVEs","How many CVEs are in each SSVC exploitation state?","CVSS 10.0 CVEs not yet exploited (SSVC none)","High-EPSS CVEs not yet listed in KEV","CVSS 9+ CVEs with low exploitation likelihood","Biggest EPSS movers since the last update","Top 20 CVEs by composite risk score","Highest-risk CVEs not yet on KEV","Risk score breakdown for CVE-2021-44228"]

# ── Auth — GitHub OAuth (NextAuth / Auth.js) ──────────────────────────────
# Create an OAuth App at github.com/settings/developers.
# Callback URL: https://your-domain/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Required by NextAuth to sign session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Public origin of the app (NextAuth uses it to build callback URLs).
# AUTH_URL=http://localhost:3000
# Self-hosted (Docker/non-Vercel) deploys behind a proxy MUST set this or NextAuth
# rejects requests with "UntrustedHost". Leave unset for local `pnpm dev`.
# AUTH_TRUST_HOST=true

# Second connection used ONLY for user_usage (rate limiting + /admin). Point it at
# the `app_usage` role so the role behind PG_DATABASE_URL — which carries the agent's
# model-authored SQL — has no access to user_usage. Unset = one role does both, and the
# only thing standing between a signed-in user and every user's github:<id> and token
# totals is validateSql's denylist on the table name — a stopgap, not the boundary.
# Grants + required rollout order: reference repo docs/supabase-readonly-role.md, Part 2.5.
# PG_USAGE_DATABASE_URL=postgresql://app_usage.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ── Authorization (allow-list; JSON arrays) ───────────────────────────────
# All three lists are matched case-insensitively.
OPEN_REGISTRATION=false                         # true = any GitHub user allowed
# ALLOWED_EMAILS=["alice@example.com"]
# Admits ANYONE whose GitHub account email ends in @<domain>. That is a GitHub
# account email, not company SSO: employees whose GitHub uses a personal address
# are denied, and anyone who keeps a company address on their GitHub account
# (including after they leave) is admitted. Set GLOBAL_DAILY_*_LIMIT below before
# enabling this — the per-user cap alone multiplies by headcount.
# ALLOWED_EMAIL_DOMAINS=["mycompany.com"]
# ALLOWED_LOGINS=["jeffhoek"]                    # GitHub usernames

# JWT session lifetime in seconds (default 24h). This is the ONLY revocation
# lever: sessions are stateless, so removing someone from the allow-list does not
# sign them out until their token expires.
# SESSION_MAX_AGE_SECONDS=86400

# ── Rate limiting (per user per UTC day, counted in Postgres user_usage) ───
DAILY_QUERY_LIMIT=20
ADMIN_DAILY_QUERY_LIMIT=100000
# Stable GitHub numeric ids (github:<id>) that get the elevated cap AND access to /admin.
# ADMIN_USER_IDENTIFIERS=["github:12345678"]

# ── Global cap: total across ALL users per UTC day (0 = disabled) ──────────
# Backstop against a runaway bill once more than a handful of people can sign in.
# Admins are exempt. Sizing: queries × ~10-30k tokens each, priced at the
# LLM_*_COST_PER_MILLION rates below. 500 queries / 15M tokens is roughly a
# $50-100/day ceiling on Sonnet-5 — set these to what you are willing to pay.
GLOBAL_DAILY_QUERY_LIMIT=0
GLOBAL_DAILY_TOKEN_LIMIT=0

# Token prices for the /admin cost estimate (USD per million tokens).
LLM_INPUT_COST_PER_MILLION=3.00
LLM_OUTPUT_COST_PER_MILLION=15.00

# ── MCP server ────────────────────────────────────────────────────────────
# Guards /api/mcp via the x-api-key header. If unset, the endpoint is UNAUTHENTICATED —
# set this before deploying. Generate: openssl rand -hex 32
MCP_API_KEY=

# ── Observability — Langfuse (optional) ───────────────────────────────────
# Set BOTH keys to enable Mastra tracing (agent runs, LLM calls, tool calls,
# token usage) exported to Langfuse. Leave unset to disable entirely.
# In dev (pnpm dev) traces flush in realtime; in production they are batched.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Default is Langfuse US cloud; change for the EU region or a self-hosted instance.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
